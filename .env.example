# Copy to .env (next to docker-compose.yml) and fill in. .env is git-ignored.

# Signs sessions and the login tokens. Anyone who knows it can log in as any user, so use a long
# random value, e.g.
#   openssl rand -base64 48
DJANGO_SECRET_KEY=

# Django's debug pages (stack traces, settings). Leave at 0 unless you are developing.
DJANGO_DEBUG=0

# Host names the site answers to, comma-separated (e.g. localhost,192.168.1.20). * means any.
DJANGO_ALLOWED_HOSTS=*

# Optional: sign in with Google through POST /api/auth/google/token (the login page doesn't use it).
# Off while GOOGLE_CLIENT_ID is empty. New accounts are created only for verified addresses on the
# domains listed here (comma-separated); every account can use the Docker socket, so keep it short.
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_DOMAINS=
